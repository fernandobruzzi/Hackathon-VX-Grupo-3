# Copie para .env. Nunca versione segredos.

# Banco. O docker-compose monta as conexoes e tem padroes so para uso local.
POSTGRES_DB=vx_materiais
DB_PORT=5432
API_BIND_PORT=8000
MIGRATION_DB_PASSWORD=
API_DB_PASSWORD=
BATCH_DB_PASSWORD=
MCP_DB_PASSWORD=
# Fora do docker-compose, informe as conexoes completas:
# MIGRATION_DATABASE_URL=postgresql+psycopg://migration_user:senha@localhost:5432/vx_materiais
# DATABASE_URL=postgresql+psycopg://api_user:senha@localhost:5432/vx_materiais
# Testes de banco: nome precisa terminar em _test, pois ele e apagado
# TEST_DATABASE_URL=postgresql+psycopg://migration_user:senha@localhost:5432/vx_materiais_test

# Arquivos: local (padrao, sem conta AWS) ou s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.storage
DATA_DIR=data/desafio01

# Planilha do PDM lida pelo servidor MCP
PDM_WORKBOOK_PATH=data/desafio01/03_padrao_cadastro_PDM.xlsx

# Algoritmos
NORMALIZATION_REPOSITORY=rule_based_v1
CLASSIFICATION_REPOSITORY=rule_based_v1
EXTRACTION_REPOSITORY=rule_based_v1
CANDIDATE_REPOSITORY=exact_identity_v1
CORRECTION_REPOSITORY=head_noun_v1
SEARCH_REPOSITORY=hybrid_v1
# Embeddings: vazio desliga. simulated_v1 (testes), ollama_nomic_v1 (local) ou bedrock_titan_v1 (AWS)
EMBEDDING_REPOSITORY=
OLLAMA_URL=http://localhost:11434

# Portas e origem
API_PORT=8000
AGENT_PORT=8001
AGENT_URL=http://localhost:8001
FRONT_DIST_DIR=

# Token interno API -> Agent: mesmo segredo nos dois servicos, com 32 bytes ou mais
AGENT_INTERNAL_TOKEN_SECRET=

# Ambiente. Atalhos locais, como a sessao de teste, so funcionam com APP_ENV=local
APP_ENV=local
LOCAL_TEST_SESSION=false
ENABLE_LOCAL_TEST_SESSIONS=false
AUTH_BACKEND=disabled
APP_ORIGIN=http://localhost:8000
# api usa sessao do servidor; mock e somente prototipo sem autenticacao.
NEXT_PUBLIC_DATA_SOURCE=api

# Para conectar Cognito: AUTH_BACKEND=cognito, ambas as flags locais false,
# APP_ORIGIN=https://<origem>, registrar <origem>/auth/callback/ no app client.
# Chave Fernet persistente, fornecida por Secrets Manager no deploy; nunca versionar.
SESSION_ENCRYPTION_KEY=
AUTHORIZED_CENTER_CODES=1100,1200,1300,2100,2200,9000
COGNITO_RESOURCE_AUDIENCE=
COGNITO_APP_CLIENT_SECRET=

# Demonstracao
DEMO_MODE=false

# AWS: preenchido nas issues de deploy e login
AWS_REGION=
S3_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=
BEDROCK_CHAT_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
